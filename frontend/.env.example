# Database (shared dev server)
DB_HOST=your_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Redis
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Public URL
NEXT_PUBLIC_SITE_URL=http://localhost:3400

# Docker
APP_PORT=3400
APP_NAME=xomdata_jobs

# Security — bật khi app chạy sau reverse proxy tin cậy (Cloudflare / Nginx).
# Default: true nếu NODE_ENV=production, false nếu dev. Override khi cần.
# Khi bật, rate-limit sẽ đọc cf-connecting-ip / x-forwarded-for.
# TRUST_PROXY_HEADERS=true

# Prisma — shared xomdata_dev MySQL (xomdata_stag trên staging, xomdata_prod trên prod)
DATABASE_URL="mysql://xomdata_app:password@10.20.2.42:3306/xomdata_stag"

# NextAuth — PHẢI giống AUTH_SECRET của xomdata_academy để share JWT cookie .xomdata.com
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Bắt buộc trên prod: nếu thiếu, /api/auth/signout redirect về HOSTNAME 0.0.0.0 (Docker default).
NEXTAUTH_URL=https://jobs.xomdata.com
AUTH_URL=https://jobs.xomdata.com
# BẮT BUỘC: ALERT_TOKEN_SECRET dùng cho HMAC unsubscribe token.
# KHÔNG fallback AUTH_SECRET (để blast radius không lan sang 3 service share).
# Generate: openssl rand -base64 48
ALERT_TOKEN_SECRET=

# Email (Hostinger SMTP — giống academy)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@xomdata.com
SMTP_PASS=
SMTP_FROM="Xóm Jobs <admin@xomdata.com>"

# Internal cron — GitHub Actions digest workflow gọi /api/internal/digest với bearer token này.
INTERNAL_DIGEST_TOKEN=
