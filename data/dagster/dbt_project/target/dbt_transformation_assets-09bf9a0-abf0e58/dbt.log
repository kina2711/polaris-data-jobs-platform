{"data": {"conn_name": "list_crawl_jobs_db_public", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.11\", \"profile_name\": \"crawl_dbt\", \"target_name\": \"dev\", \"connection_name\": \"list_crawl_jobs_db_public\"} */\nselect\n      'crawl_jobs_db' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'public'\n    union all\n    select\n      'crawl_jobs_db' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'public'\n    union all\n    select\n      'crawl_jobs_db' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'public'\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "9b248aa1-bf70-494a-b4b7-2606ece60ff4", "level": "debug", "msg": "On list_crawl_jobs_db_public: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.11\", \"profile_name\": \"crawl_dbt\", \"target_name\": \"dev\", \"connection_name\": \"list_crawl_jobs_db_public\"} */\nselect\n      'crawl_jobs_db' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'public'\n    union all\n    select\n      'crawl_jobs_db' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'public'\n    union all\n    select\n      'crawl_jobs_db' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'public'\n  ", "name": "SQLQuery", "pid": 18347, "thread": "ThreadPoolExecutor-1_0", "ts": "2026-06-10T01:56:20.416721Z"}}
