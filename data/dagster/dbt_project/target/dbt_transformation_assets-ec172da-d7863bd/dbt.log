{"data": {"conn_name": "list_crawl_jobs_db_public", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.11\", \"profile_name\": \"crawl_dbt\", \"target_name\": \"dev\", \"connection_name\": \"list_crawl_jobs_db_public\"} */\nselect\n      'crawl_jobs_db' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'public'\n    union all\n    select\n      'crawl_jobs_db' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'public'\n    union all\n    select\n      'crawl_jobs_db' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'public'\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "1e8fa778-4832-4606-a93f-65a595d30b1e", "level": "debug", "msg": "On list_crawl_jobs_db_public: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.11\", \"profile_name\": \"crawl_dbt\", \"target_name\": \"dev\", \"connection_name\": \"list_crawl_jobs_db_public\"} */\nselect\n      'crawl_jobs_db' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'public'\n    union all\n    select\n      'crawl_jobs_db' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'public'\n    union all\n    select\n      'crawl_jobs_db' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'public'\n  ", "name": "SQLQuery", "pid": 26272, "thread": "ThreadPoolExecutor-1_0", "ts": "2026-06-10T07:23:36.597792Z"}}
