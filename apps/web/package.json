{
  "name": "polaris-data-jobs-web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "prisma generate && next build",
    "start": "next start -p 3400",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:validate": "prisma validate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@xenova/transformers": "^2.17.2",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.577.0",
    "next": "15.5.20",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.4",
    "nodemailer": "9.0.3",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "sanitize-html": "2.17.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.20",
    "postcss": "8.5.19",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "ios >= 16.4",
    "not dead"
  ],
  "overrides": {
    "nodemailer": "$nodemailer",
    "postcss": "$postcss",
    "protobufjs": "7.6.3"
  }
}
