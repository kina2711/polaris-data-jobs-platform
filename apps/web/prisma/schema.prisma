// Schema cho aquila_lab. Tổ chức:
//   - `User` = MIRROR read-only từ academy (academy own migrations User).
//   - `JobAlert` + `JobAlertDelivery` = OWNED bởi repo này từ 2026-04-22.
//     Migrations mới cho 2 model này đi qua `prisma/migrations/` của repo này;
//     academy giữ model tương đương ở schema để có Prisma Client nhưng KHÔNG
//     tạo migration mới cho JobAlert/JobAlertDelivery.
// Shared DB giữa 4 service (academy/admin/jobs/dataset) → `_prisma_migrations`
// chung; mỗi repo chỉ manage migrations của riêng mình, Prisma skip phần không
// biết (không phải "pending").

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// Read-only reference — jobs app reads email/name for digests but never
// inserts/updates users. CRUD happens in academy.
model User {
  id            String     @id
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  role          String     @default("student")
  isBlocked     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  jobAlerts     JobAlert[]

  @@map("User")
}

model JobAlert {
  id         String             @id @default(cuid())
  userId     String
  name       String             @db.VarChar(120)
  filters    Json
  frequency  String             @default("daily")
  sendHour   Int                @default(8)
  weekday    Int?
  timezone   String             @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  active     Boolean            @default(true)
  lastSentAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries JobAlertDelivery[]

  @@index([userId])
  @@index([active, frequency])
  @@map("JobAlert")
}

model JobAlertDelivery {
  id         String   @id @default(cuid())
  alertId    String
  sentAt     DateTime @default(now())
  jobIds     Json
  providerId String?  @db.VarChar(200)
  alert      JobAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, sentAt])
  @@map("JobAlertDelivery")
}

model RawJob {
  id           String    @id
  title        String?
  company      String?
  location     String?
  salary       String?
  experience   String?
  description  String?
  requirements String?
  tags         String?
  source       String?
  url          String?
  crawled_at   DateTime?
  embedding    Unsupported("vector(384)")?

  @@map("raw_jobs")
}
