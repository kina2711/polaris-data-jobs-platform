# Canonical PostgreSQL/pgvector database
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/crawl_jobs_db"
DB_NAME=crawl_jobs_db

# Optional web-only Docker Compose host settings
APP_NAME=polaris_web
APP_PORT=3400

# Redis cache and rate-limit store
REDIS_URL="redis://localhost:6379/1"
# Set to false only for a controlled development endpoint with a self-signed certificate.
REDIS_TLS_REJECT_UNAUTHORIZED=true

# Public Polaris web origin
NEXT_PUBLIC_SITE_URL=http://localhost:3400
# Optional login page and identity-service origin. Authentication providers are
# NOT_IMPLEMENTED in this repository and require an approved Polaris IdP contract.
NEXT_PUBLIC_LOGIN_URL=
NEXT_PUBLIC_AUTH_ORIGIN=

# NextAuth/session signing
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3400

# Separate HMAC keys for one-click unsubscribe and internal automation.
ALERT_TOKEN_SECRET=
INTERNAL_DIGEST_TOKEN=
INTERNAL_VECTORIZER_TOKEN=

# Trust Cloudflare/Nginx client-IP headers only behind a controlled reverse proxy.
TRUST_PROXY_HEADERS=false

# Optional job-alert delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Polaris Jobs <noreply@localhost>"
