# Docker Compose development defaults. Copy to .env and replace all secrets.
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=crawl_jobs_db
MINIO_USER=polaris
MINIO_PASSWORD=change-me
CUBEJS_API_SECRET=change-me
CUBEJS_DEV_MODE=false
METABASE_DB_NAME=polaris_metabase
DAGSTER_DB_NAME=polaris_dagster

NEXT_PUBLIC_SITE_URL=http://localhost:3400
NEXT_PUBLIC_LOGIN_URL=
NEXT_PUBLIC_AUTH_ORIGIN=
AUTH_SECRET=
ALERT_TOKEN_SECRET=
INTERNAL_DIGEST_TOKEN=
INTERNAL_VECTORIZER_TOKEN=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Polaris Jobs <noreply@localhost>"

# Optional notification sink. Never commit an actual webhook URL.
DISCORD_WEBHOOK_URL=
